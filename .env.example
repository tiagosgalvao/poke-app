# Copy to .env and adjust. docker compose reads it automatically.
POSTGRES_DB=poke
POSTGRES_USER=poke
POSTGRES_PASSWORD=poke

# At least 32 bytes for HS256. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-in-env-this-is-only-a-local-dev-secret-32b
JWT_TTL=2h

CACHE_TTL=24h
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

API_PORT=8080
WEB_PORT=3000
